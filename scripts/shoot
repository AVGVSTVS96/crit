#!/usr/bin/env bash
# usage: shoot <url> <out-dir>
# Screenshots the whole page one screen at a time at desktop and phone widths,
# and writes styles.md: every font size, weight, family and color the page uses.
set -euo pipefail
url=$1 out=$2
s="crit-$$"
mkdir -p "$out"
trap 'agent-browser --session "$s" close >/dev/null 2>&1 || true' EXIT

census='(() => {
  const tally = {}, add = (k, v) => ((tally[k] ??= {})[v] = (tally[k][v] || 0) + 1);
  for (const el of document.querySelectorAll("body *")) {
    const cs = getComputedStyle(el), r = el.getBoundingClientRect();
    if (cs.display === "none" || cs.visibility === "hidden" || !r.width || !r.height) continue;
    if (cs.backgroundColor !== "rgba(0, 0, 0, 0)") add("background", cs.backgroundColor);
    if (![...el.childNodes].some(n => n.nodeType === 3 && n.textContent.trim())) continue;
    add("font size", cs.fontSize);
    add("font weight", cs.fontWeight);
    add("font family", cs.fontFamily.split(",")[0].replace(/["\x27]/g, ""));
    add("text color", cs.color);
  }
  return Object.entries(tally).map(([k, v]) => {
    const rows = Object.entries(v).sort((a, b) => b[1] - a[1]);
    return `## ${k}: ${rows.length} distinct\n` + rows.map(([x, n]) => `- ${x} (${n})`).join("\n");
  }).join("\n\n");
})()'

: > "$out/styles.md"
for size in desktop:1440x900 phone:390x844; do
  name=${size%%:*} dims=${size#*:} w=${dims%x*} h=${dims#*x}
  agent-browser --session "$s" set viewport "$w" "$h" >/dev/null
  agent-browser --session "$s" open "$url" >/dev/null
  agent-browser --session "$s" wait 2500 >/dev/null
  total=$(agent-browser --session "$s" eval 'document.documentElement.scrollHeight' | tr -dc 0-9)
  i=0 y=0
  while (( y < total && i < 30 )); do
    agent-browser --session "$s" eval "window.scrollTo(0,$y)" >/dev/null
    agent-browser --session "$s" wait 900 >/dev/null
    agent-browser --session "$s" screenshot "$out/$name-$(printf %02d $i).png" >/dev/null
    i=$((i+1)) y=$((y+h-100))
  done
  { echo "# $name, ${w}px wide"; echo
    agent-browser --session "$s" eval "$census" | sed 's/^"//; s/"$//; s/\\n/\n/g'; echo; } >> "$out/styles.md"
done
ls "$out"
