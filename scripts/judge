#!/usr/bin/env bash
# usage: judge "<what it is>" "<what people come to do>" <out-dir> <shots> [<after-shots>]
# One shots folder: both judges review it. Two: both compare them as A and B,
# in an order they aren't told, written to <out-dir>/key.txt.
set -euo pipefail
shopt -s nullglob
what=$1 tasks=$2 out=$(realpath -m "$3"); shift 3
here=$(dirname "$(realpath "$0")")/..
packet="$out/packet"
rm -rf "$packet"; mkdir -p "$packet"

styles=""
add() { # <label> <dir>
  local f
  for f in "$2"/*.png; do cp "$f" "$packet/${1:+$1-}${f##*/}"; done
  styles+=$'\n\n'"${1:+# Version $1}"$'\n'"$(sed 's/^# /## /' "$2/styles.md")"
}
if (( $# == 1 )); then
  prompt=$here/review.md
  add "" "$1"
else
  prompt=$here/compare.md
  if (( RANDOM % 2 )); then a=$1 b=$2; else a=$2 b=$1; fi
  printf 'A: %s\nB: %s\n' "$(realpath "$a")" "$(realpath "$b")" > "$out/key.txt"
  add A "$a"; add B "$b"
fi

text=$(sed -e "s|{{what}}|$what|" -e "s|{{tasks}}|$tasks|" "$prompt")
imgs=("$packet"/*.png)
names=$(printf '%s\n' "${imgs[@]##*/}")
text+=$'\n\nScreenshots, in order:\n'"$names$styles"

"$here/scripts/panel" "$packet" "$out" "$text"
echo "$out/opus.md"; echo "$out/sol.md"
