#!/usr/bin/env bash
# usage: judge "<what it is>" "<what people come to do>" <out-dir> <shots> [<after-shots>]
# One shots folder: both judges review it. Two: both compare them as A and B,
# in an order they aren't told, written to <out-dir>/key.txt.
# The judges see only the screenshots and the prompt: no CLAUDE.md, AGENTS.md,
# settings, hooks, MCP servers or memories.
set -euo pipefail
shopt -s nullglob
what=$1 tasks=$2 out=$(realpath -m "$3"); shift 3
here=$(dirname "$(realpath "$0")")/..
packet="$out/packet"
rm -rf "$packet"; mkdir -p "$packet"

styles=""
add() { # <label> <dir>
  local f
  for f in "$2"/*.png; do cp "$f" "$packet/${1:+$1-}${f##*/}"; done
  styles+=$'\n\n'"${1:+# Version $1}"$'\n'"$(sed 's/^# /## /' "$2/styles.md")"
}
if (( $# == 1 )); then
  prompt=$here/review.md
  add "" "$1"
else
  prompt=$here/compare.md
  if (( RANDOM % 2 )); then a=$1 b=$2; else a=$2 b=$1; fi
  printf 'A: %s\nB: %s\n' "$(realpath "$a")" "$(realpath "$b")" > "$out/key.txt"
  add A "$a"; add B "$b"
fi

text=$(sed -e "s|{{what}}|$what|" -e "s|{{tasks}}|$tasks|" "$prompt")
imgs=("$packet"/*.png)
names=$(printf '%s\n' "${imgs[@]##*/}")
text+=$'\n\nScreenshots, in order:\n'"$names$styles"

( cd "$packet" && claude -p --model claude-opus-5-5 --effort medium --tools Read --no-session-persistence \
    --setting-sources "" --strict-mcp-config "$text" > "$out/opus.md" 2> "$out/opus.err" ) &

codex_home=$(mktemp -d)
trap 'rm -rf "$codex_home"' EXIT
ln -s "${CODEX_HOME:-$HOME/.codex}/auth.json" "$codex_home/auth.json"
sol=(-m gpt-6.1-sol -c model_reasoning_effort=medium --ephemeral -s read-only --skip-git-repo-check)
for f in memories shell_tool unified_exec skill_search plugins apps browser_use computer_use multi_agent image_generation; do sol+=(--disable "$f"); done
for i in "${imgs[@]}"; do sol+=(-i "$i"); done
CODEX_HOME=$codex_home codex exec "${sol[@]}" -C "$packet" -o "$out/sol.md" "$text" > "$out/sol.log" 2>&1 </dev/null &
wait
echo "$out/opus.md"; echo "$out/sol.md"
