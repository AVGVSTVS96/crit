#!/usr/bin/env bash
# usage: judge <target> <shots-dir> <out-dir> [prompt-file]
# Runs the Opus and Sol judges on the same screenshots, side by side.
set -euo pipefail
shopt -s nullglob
target=$1 shots=$(realpath "$2") out=$(realpath -m "$3")
prompt=${4:-$(dirname "$(realpath "$0")")/../review.md}
mkdir -p "$out"
text=$(sed "s|{{target}}|$target|" "$prompt")
imgs=("$shots"/*.{png,jpg,jpeg,webp})
(( ${#imgs[@]} )) || { echo "no screenshots in $shots" >&2; exit 1; }
mapfile -t imgs < <(printf '%s\n' "${imgs[@]}" | sort)
names=$(printf '%s\n' "${imgs[@]##*/}")

( cd "$shots" && claude -p --model claude-opus-5-5 --effort medium --tools Read --no-session-persistence \
    "$text"$'\n\nScreenshots, in this folder:\n'"$names" > "$out/opus.md" 2> "$out/opus.err" ) &

sol=(-m gpt-6.1-sol -c model_reasoning_effort=medium --ignore-user-config --ephemeral -s read-only --skip-git-repo-check)
for f in memories shell_tool unified_exec skill_search plugins apps browser_use computer_use multi_agent image_generation; do sol+=(--disable "$f"); done
for i in "${imgs[@]}"; do sol+=(-i "$i"); done
codex exec "${sol[@]}" -C "$shots" -o "$out/sol.md" "$text"$'\n\nScreenshots, in order:\n'"$names" > "$out/sol.log" 2>&1 </dev/null &
wait
echo "$out/opus.md"; echo "$out/sol.md"
