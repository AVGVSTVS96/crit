#!/usr/bin/env bash
# usage: panel <packet-dir> <out-dir> <prompt-text>
# Runs both judges at medium effort on the images in <packet-dir>, writing
# <out-dir>/opus.md and <out-dir>/sol.md. They see only the images and the
# prompt: no CLAUDE.md, AGENTS.md, settings, hooks, MCP servers or memories.
set -euo pipefail
shopt -s nullglob
packet=$1 out=$2 text=$3
imgs=("$packet"/*.png)

( cd "$packet" && claude -p --model claude-opus-5-5 --effort medium --tools Read --no-session-persistence \
    --setting-sources "" --strict-mcp-config "$text" > "$out/opus.md" 2> "$out/opus.err" ) &

codex_home=$(mktemp -d)
trap 'rm -rf "$codex_home"' EXIT
ln -s "${CODEX_HOME:-$HOME/.codex}/auth.json" "$codex_home/auth.json"
sol=(-m gpt-6.1-sol -c model_reasoning_effort=medium --ephemeral -s read-only --skip-git-repo-check)
for f in memories shell_tool unified_exec skill_search plugins apps browser_use computer_use multi_agent image_generation; do sol+=(--disable "$f"); done
for i in "${imgs[@]}"; do sol+=(-i "$i"); done
CODEX_HOME=$codex_home codex exec "${sol[@]}" -C "$packet" -o "$out/sol.md" "$text" > "$out/sol.log" 2>&1 </dev/null &
wait
